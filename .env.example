# Copy to .env.local for `vercel dev` (optional). In production, set these in Vercel → Project → Settings → Environment Variables.

OPENROUTER_API_KEY=sk-or-v1-...
# Optional: default when the UI is on "Server default" (see https://openrouter.ai/models)
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: your public site URL for OpenRouter HTTP-Referer (defaults to https://YOUR_PROJECT.vercel.app)
# OPENROUTER_SITE_URL=https://your-app.vercel.app

# Optional: Vercel → Storage → Postgres (Neon). Link the database to the project; POSTGRES_URL is injected automatically.
# Without it, past results are still saved in the browser (localStorage).
# POSTGRES_URL=postgres://...

# Optional: Udio / Chirp API (https://udioapi.pro/docs) — “Send to Udio” after you generate lyrics.
# UDIO_API_KEY=your_bearer_token

# Optional: Kie.ai Suno API (https://docs.kie.ai/suno-api/quickstart) — “Kie.ai Suno API” panel in the UI.
# KIE_API_KEY=your_bearer_token
# Public https URL Kie will POST to (defaults to https://YOUR_VERCEL_DOMAIN/api/kie-callback). Required if local http dev rejects callbacks.
# KIE_CALLBACK_URL=https://your-app.vercel.app/api/kie-callback

# Optional: Vercel Blob — “upload audio” on Kie tabs (Cover / Upload extend / + Instrumental / + Vocals).
# In Vercel → Storage → Create → Blob (public). Link to the project; BLOB_READ_WRITE_TOKEN is added automatically.
# Local: vercel env pull
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
